# Copy to deploy/config.env (gitignored) and fill in. Sourced by the deploy/*.sh scripts.
#
# One file per service. To run the baseline and SSP5-8.5 datasets side by side,
# make e.g. deploy/ssp585.env with SERVICE=clio-ssp585 and
# NETCDF_FILE=farfuture585_surface.nc, then: CLIO_CONFIG=deploy/ssp585.env bash deploy/deploy.sh

# --- Google Cloud project ---
PROJECT_ID=                       # e.g. clio-pilot-123456
BILLING_ACCOUNT=                  # e.g. 012345-6789AB-CDEF01 (gcloud billing accounts list)
REGION=us-east1
SERVICE=clio                      # e.g. clio-baseline / clio-ssp585, one per dataset
REPO=clio                         # Artifact Registry repository name
SERVICE_ACCOUNT_NAME=clio-run
SECRET_NAME=gemini-api-key

# --- Data on Cloud Storage ---
BUCKET=                           # globally unique, e.g. clio-pilot-123456-data
DATA_VERSION=v1                   # data lives under gs://$BUCKET/$DATA_VERSION/
NETCDF_FILE=baseline_surface.nc   # or farfuture585_surface.nc
CHROMADB_COLLECTION=domain_knowledge
RAG_ENABLED=true                  # false: deploy with an empty knowledge base (no Chroma DB yet)
LOCAL_NETCDF_DIR=data/netcdf      # where upload_data.sh reads the .nc files from
LOCAL_CHROMADB_DIR=data/chromadb  # optional: built locally with `python rag/rag_manager.py`
LOCAL_DOCS_DIR=documents/rag      # RAG source PDFs, for deploy/build_chromadb.sh

# --- Gemini ---
# REQUIRED: a pinned model ID, not a -latest alias. Use the same model the agent was
# benchmarked with, so the deployed agent is the one the evaluation describes.
# Use a paid-tier key: free-tier prompts may be used by Google, and prompts carry
# statistics from unpublished BISECT model output.
GEMINI_MODEL=

# --- Cost controls ---
BUDGET_USD=50                     # monthly budget; email alerts at 50%, 90%, 100%
MIN_INSTANCES=0                   # 0 = no idle cost (expect cold starts)
MAX_INSTANCES=1                   # 1 keeps Nominatim lookups within 1 request/second
DAILY_QUERY_LIMIT=100             # per instance, so at most MAX_INSTANCES x this per day
QUERY_RATE_PER_MINUTE=6           # per client
REGION_RATE_PER_MINUTE=6          # per client; each selection makes 5 OpenStreetMap Nominatim calls
MAX_MESSAGE_CHARS=4000
MAX_REQUEST_BYTES=262144
ALLOWED_ORIGINS=                  # leave empty: the bundled frontend is same-origin

# --- OpenStreetMap Nominatim (place names for map selections) ---
NOMINATIM_USER_AGENT=             # optional, quoted, e.g. "CLIO/0.1 (contact: you@university.edu)"
NOMINATIM_MIN_INTERVAL=1.1        # seconds between lookups; use 2.2 when running two services

# --- Audit log (benchmarking and human-on-the-loop review) ---
AUDIT_LOG=false                   # true logs each question, answer and cited source to Cloud Logging
